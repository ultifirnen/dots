{
    "layer": "top",
    "position": "top",
    "height": 20,
    "spacing": 0,
    "reload_style_on_change": true,

    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["mpris", "pulseaudio", "cpu", "custom/gpu", "memory", "tray"],

    "mango/workspaces": {
        "format": "{id}",
        "disable-scroll": true,
        "all-outputs": true,
        "sort-by-number": true
    },

    "hyprland/window": {
        "format": "<span color='#6B6453'>~/&gt;</span> {title}",
        "separate-outputs": true,
        "max-length": 40
    },

    "clock": {
        "format": "<span color='#6B6453'>[</span> {:%a %d.%m  %H:%M:%S} <span color='#6B6453'>]</span>",
        "interval": 1,
        "tooltip": false
    },

    "mpris": {
        "format": "<span color='#6B6453'>&gt;</span> {title}",
        "format-paused": "<span color='#6B6453'>||</span> {title}",
        "max-length": 32,
        "tooltip": false
    },

    "pulseaudio": {
        "format": "<span color='#6B6453'>VOL</span> {volume:>3}%",
        "format-muted": "<span color='#6B6453'>VOL</span> MUTE",
        "on-click": "pavucontrol",
        "scroll-step": 5,
        "tooltip": false
    },

    "cpu": {
        "format": "<span color='#6B6453'>CPU</span> {usage:>3}%",
        "interval": 2,
        "tooltip": false
    },

    "custom/gpu": {
        "exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits",
        "format": "<span color='#6B6453'>GPU</span> {:>3}%",
        "interval": 2,
        "tooltip": false
    },

    "memory": {
        "format": "<span color='#6B6453'>RAM</span> {percentage:>3}%",
        "interval": 5,
        "tooltip": false
    },

    "tray": {
        "icon-size": 12,
        "spacing": 6
    }
}
