{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "/home/ult/Documents/sun.png",
    "width": 30,
    "padding": { "right": 3 }
  },
  "display": {
    "separator": ""
  },
  "modules": [
    { "type": "custom", "format": "╭──────────────────────────", "outputColor": "90" },
    { "type": "os",       "key": "│ ● os       ", "keyColor": "blue" },
    { "type": "kernel",   "key": "│ ● kernel   ", "keyColor": "red" },
    { "type": "packages", "key": "│ ● packages ", "keyColor": "yellow" },
    { "type": "display",  "key": "│ ● display  ", "keyColor": "green" },
    { "type": "terminal", "key": "│ ● term     ", "keyColor": "cyan" },
    { "type": "wm",       "key": "│ ● wm       ", "keyColor": "magenta" },
    { "type": "custom", "format": "╰──────────────────────────", "outputColor": "90" },

    { "type": "custom", "format": "╭──────────────────────────", "outputColor": "90" },
    { "type": "title",    "format": "│ ● {user-name}@{host-name}" },
    { "type": "cpu",      "key": "│ ● cpu      ", "keyColor": "blue" },
    { "type": "gpu",      "key": "│ ● gpu      ", "keyColor": "green" },
    { "type": "memory",   "key": "│ ● memory   ", "keyColor": "yellow" },
    { "type": "uptime",   "key": "│ ● uptime   ", "keyColor": "magenta" },
    { "type": "custom", "format": "╰──────────────────────────", "outputColor": "90" },

    { "type": "colors", "key": " ", "symbol": "circle" },
    { "type": "datetime", "key": " ", "format": "{hour-pretty}:{minute-pretty}" }
  ]
}
