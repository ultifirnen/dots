{
    "layer": "top",
    "position": "top",
    "height": 18,
    "spacing": 0,

    "modules-left": ["hyprland/workspaces", "mpris"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "pulseaudio", "cpu", "custom/gpu", "memory"],

    "hyprland/workspaces": {
        "format": "{id}",
        "disable-scroll": true,
        "all-outputs": true,
        "sort-by-number": true
    },

    "mpris": {
        "format": "\uf04b {title}",
        "format-paused": "\uf04c {title}",
        "max-length": 45,
        "tooltip": false
    },

    "tray": {
        "icon-size": 12,
        "spacing": 6
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "\uf466 mute",
        "format-icons": {
            "default": ["\uf026", "\uf027", "\uf028"]
        },
        "on-click": "pavucontrol",
        "scroll-step": 5
    },

    "cpu": {
        "format": "\uf2db {usage}%",
        "interval": 2
    },

    "custom/gpu": {
        "exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits",
        "format": "\udb82\udcae {}%",
        "interval": 2
    },

    "memory": {
        "format": "\uefc5 {percentage}%",
        "interval": 5
    },

    "clock": {
        "format": "[ \uf017 {:%d.%m  %H:%M} ]",
        "interval": 1,
        "tooltip": false
    }
}
