/* ~/.config/rofi/theme.rasi
   Квадратная, чёрно-фиолетовая. Цвета те же, что в waybar. */

* {
    bg:      #0d0c0a;
    surface: #1a1814;
    line:    #2b2820;
    fg:      #e8dcc0;
    muted:   #6b6350;
    accent:  #a47fe0;

    background-color: transparent;
    text-color:       @fg;
    font:             "DepartureMono Nerd Font 8.25";
}

window {
    location:         center;
    anchor:           center;
    width:            540px;
    background-color: @bg;
    border:           1px;
    border-color:     @accent;
    border-radius:    0;
}

mainbox {
    padding:  10px;
    spacing:  8px;
    children: [ "inputbar", "message", "listview", "mode-switcher" ];
}

inputbar {
    padding:          7px 14px;
    spacing:          8px;
    background-color: @surface;
    border:           1px;
    border-color:     @line;
    border-radius:    0;
    children:         [ "prompt", "entry" ];
}

prompt {
    text-color: @accent;
}

entry {
    placeholder:       "поиск";
    placeholder-color: @muted;
}

message {
    padding:          7px 14px;
    border:           1px;
    border-color:     @line;
    border-radius:    0;
    background-color: @surface;
}

textbox {
    text-color: @muted;
}

listview {
    lines:        8;
    columns:      1;
    spacing:      2px;
    scrollbar:    false;
    fixed-height: false;
    dynamic:      true;
}

element {
    padding:       7px 14px;
    spacing:       10px;
    border-radius: 0;
}

element-icon {
    size:           1.5em;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
    highlight:      bold;
}

element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color:       @fg;
}

/* выбранная строка: сплошной фиолетовый прямоугольник */
element selected.normal {
    background-color: @accent;
    text-color:       @bg;
}

/* активное устройство в меню звука */
element normal.active, element alternate.active {
    text-color: @accent;
}

element selected.active {
    background-color: @fg;
    text-color:       @bg;
}

mode-switcher {
    spacing: 4px;
}

button {
    padding:          6px 12px;
    border:           1px;
    border-color:     @line;
    border-radius:    0;
    background-color: @surface;
    text-color:       @muted;
    horizontal-align: 0.5;
}

button selected {
    background-color: @accent;
    border-color:     @accent;
    text-color:       @bg;
}
