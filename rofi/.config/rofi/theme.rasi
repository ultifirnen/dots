* {
    bg:      #040404;
    surface: #281619;
    hover:   #532E37;
    line:    #743C4C;
    fg:      #C48B89;
    muted:   #6B6453;

    font: "JetBrainsMono Nerd Font 11";
    background-color: transparent;
    text-color: @fg;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    location: center;
    anchor: center;
    width: 520px;
    background-color: @bg;
    border: 1px;
    border-color: @line;
    border-radius: 0;
}

mainbox {
    children: [ inputbar, message, listview ];
}

inputbar {
    padding: 8px 12px;
    spacing: 8px;
    border: 0 0 1px 0;
    border-color: @line;
    children: [ prompt, entry ];
}

prompt {
    text-color: @muted;
}

entry {
    placeholder: "_";
    placeholder-color: @muted;
    text-color: @fg;
}

message {
    padding: 6px 12px;
    border: 0 0 1px 0;
    border-color: @line;
}

textbox {
    text-color: @muted;
}

listview {
    lines: 8;
    columns: 1;
    scrollbar: false;
    fixed-height: false;
    padding: 4px 0;
}

element {
    padding: 3px 12px;
    spacing: 8px;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element normal.active,
element alternate.active {
    text-color: @muted;
}

element selected.normal,
element selected.active {
    background-color: @fg;
    text-color: @bg;
}

element selected.urgent {
    background-color: @hover;
    text-color: @fg;
}

element-icon {
    size: 1.2em;
    vertical-align: 0.5;
}

element-text {
    background-color: inherit;
    text-color: inherit;
    vertical-align: 0.5;
    highlight: underline;
}
