/* сетка с превью для выбора обоев */
@import "/home/ult/.config/rofi/theme.rasi"

window {
    width: 900px;
}

listview {
    columns: 3;
    lines:   3;
    spacing: 8px;
}

element {
    orientation: vertical;
    padding:     8px;
    spacing:     6px;
}

element-icon {
    size:             11em;
    horizontal-align: 0.5;
}

element-text {
    horizontal-align: 0.5;
}

